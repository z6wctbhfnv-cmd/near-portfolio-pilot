# Copy to .env and fill in. Never commit .env.
# Every key is optional: with none set, the backend runs paper pilots and backtests on public data.

# --- NEAR Intents Agent API (mainnet-only beta; real funds) ---
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# Partner API key from the partner portal. Backend only, never in a browser.
NEAR_INTENTS_AGENT_API_KEY=
# 1Click partner key (JWT). The Agent API does not accept it: its swap has no app-fee field, so
# Pilot cannot add a spot fee through it (docs/REVENUE.md). Kept for a direct 1Click integration.
NEAR_INTENTS_PARTNER_KEY=
# Master switch for real swaps. Leave false until you have tested with small amounts.
LIVE_EXECUTION=false
# Minimum output on live swaps = quoted output minus this (basis points, 0-300).
MAX_SLIPPAGE_BPS=100
# Cost charged on paper fills and in backtests (basis points).
PAPER_COST_BPS=30

# --- NEAR AI Cloud (mandate parsing + weekly review). Without it, rule-based fallbacks run. ---
NEARAI_API_KEY=
NEARAI_MODEL=deepseek/deepseek-v3.2

# --- OutLayer (strategy runs inside a TEE, with an attestation per run) ---
# auto = OutLayer when configured, otherwise the same WASM locally; local; outlayer (no fallback)
STRATEGY_ENGINE=auto
OUTLAYER_PAYMENT_KEY=
# owner/project of the deployed strategies/ module, e.g. pilot.near/portfolio-strategies
OUTLAYER_PROJECT=

# --- Strategy NFT (contracts/strategy-nft). Optional; without it runs stay local. ---
# The backend is the contract's recorder: once a week it appends one checkpoint per minted script.
# append_checkpoint takes no deposit, so use a FUNCTION-CALL key limited to that method
# (near account add-key <recorder> grant-function-call-access --function-names append_checkpoint ...).
STRATEGY_NFT_CONTRACT=pilot-nft2-14805.testnet
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- Weekly copy fees and the author bond (backend/src/fees.ts, copying.ts) ---
# The fee ledger is always computed; paper pilots pay from paper USDC. Live pilots send a payment
# only with this AND LIVE_EXECUTION on, after the owner signed a policy with the fee destination
# (a USDC withdraw to STRATEGY_NFT_CONTRACT). Turning it on changes the policy new pilots sign.
FEE_PAYMENTS_ENABLED=false
# FEE_ASSET_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# MIN_FEE_USD=1
# Copied script with a short holder bond: live = block live pilots (default), all, off.
BOND_GATE=live
# Report copiers' capital to the NFT contract weekly (an on-chain write; the recorder key must allow it).
NFT_REPORT_COPIED_CAPITAL=false

# --- Service ---
PORT=8787
HOST=127.0.0.1
# If set, every route except /health and /v1/config needs "Authorization: Bearer <token>".
PILOT_API_TOKEN=
# Browser origins allowed to call the API (comma-separated), e.g. the web app's site. Empty = any.
CORS_ORIGINS=
# Owners allowed to create live pilots (NEAR accounts, EVM addresses, passkey credential ids). Empty = anyone.
LIVE_OWNERS=
# Encrypts grant tokens at rest. If empty, a random key file is created next to the database.
PILOT_MASTER_KEY=
# DATABASE_PATH=./data/pilot.sqlite
SCHEDULER_ENABLED=true
REVIEW_EVERY_DAYS=7

# --- Hyperliquid TESTNET perps (backend/src/perps.ts; research in pilot/hyperliquid.py) ---
# Off by default. Testnet only: there is no mainnet switch. Use an API wallet key (it cannot withdraw).
HL_PERPS_ENABLED=false
HL_TESTNET_PRIVATE_KEY=
# The account the API wallet trades for (if the key is an API wallet).
HL_ACCOUNT_ADDRESS=
HL_TESTNET_ADDRESS=
# Pilot's builder address: orders then carry a 0.05% builder fee (the account approves it once).
HL_BUILDER_ADDRESS=
HL_MAX_LEVERAGE=1
HL_MAX_ORDER_USD=200
