# Copy to .env and fill in. Never commit .env.
# Every key is optional: with none set, the backend runs paper pilots and backtests on public data.

# --- NEAR Intents Agent API (mainnet-only beta; real funds) ---
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# Partner API key from the partner portal. Backend only, never in a browser.
NEAR_INTENTS_AGENT_API_KEY=
# Not used by the backend yet (kept for a later 1Click partner integration).
NEAR_INTENTS_PARTNER_KEY=
# Master switch for real swaps. Leave false until you have tested with small amounts.
LIVE_EXECUTION=false
# Minimum output on live swaps = quoted output minus this (basis points, 0-300).
MAX_SLIPPAGE_BPS=100
# Cost charged on paper fills and in backtests (basis points).
PAPER_COST_BPS=30

# --- NEAR AI Cloud (mandate parsing + weekly review). Without it, rule-based fallbacks run. ---
NEARAI_API_KEY=
NEARAI_MODEL=deepseek/deepseek-v3.2

# --- OutLayer (strategy runs inside a TEE, with an attestation per run) ---
# auto = OutLayer when configured, otherwise the same WASM locally; local; outlayer (no fallback)
STRATEGY_ENGINE=auto
OUTLAYER_PAYMENT_KEY=
# owner/project of the deployed strategies/ module, e.g. pilot.near/portfolio-strategies
OUTLAYER_PROJECT=

# --- Strategy NFT (contracts/strategy-nft). Optional; without it runs stay local. ---
NEAR_ACCOUNT_ID=
# Key of NEAR_ACCOUNT_ID, ed25519:... It must be a FULL-ACCESS key: record_run attaches a storage
# deposit, which function-call keys cannot. Use a dedicated account holding only a little NEAR,
# and add it as a recorder on the contract (add_recorder).
NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
STRATEGY_NFT_CONTRACT=

# --- Service ---
PORT=8787
HOST=127.0.0.1
# If set, every route except /health and /v1/config needs "Authorization: Bearer <token>".
PILOT_API_TOKEN=
# Encrypts grant tokens at rest. If empty, a random key file is created next to the database.
PILOT_MASTER_KEY=
# DATABASE_PATH=./data/pilot.sqlite
SCHEDULER_ENABLED=true
REVIEW_EVERY_DAYS=7
